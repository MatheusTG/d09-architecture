  <circuit name="contador">
    <a name="appearance" val="custom"/>
    <a name="circuit" val="contador"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="32.0"/>
    <appear>
      <rect fill="none" height="30" stroke="#000000" width="60" x="50" y="45"/>
      <text dominant-baseline="central" font-family="SansSerif" font-size="7" text-anchor="middle" x="97" y="50">Ciclos</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="7" text-anchor="middle" x="68" y="50">Contador</text>
      <circ-anchor facing="east" x="80" y="60"/>
      <circ-port dir="in" pin="120,220" x="50" y="60"/>
      <circ-port dir="out" pin="220,190" x="110" y="60"/>
    </appear>
    <comp lib="0" loc="(120,220)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="clock"/>
    </comp>
    <comp lib="0" loc="(220,190)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="count"/>
      <a name="type" val="output"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(80,200)" name="Constant">
      <a name="width" val="32"/>
    </comp>
    <comp lib="3" loc="(120,190)" name="Adder">
      <a name="width" val="32"/>
    </comp>
    <comp lib="5" loc="(140,160)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="width" val="32"/>
    </comp>
    <wire from="(120,190)" to="(140,190)"/>
    <wire from="(120,220)" to="(130,220)"/>
    <wire from="(130,210)" to="(130,220)"/>
    <wire from="(130,210)" to="(140,210)"/>
    <wire from="(130,220)" to="(130,230)"/>
    <wire from="(130,230)" to="(140,230)"/>
    <wire from="(200,190)" to="(210,190)"/>
    <wire from="(210,150)" to="(210,190)"/>
    <wire from="(210,190)" to="(220,190)"/>
    <wire from="(70,150)" to="(210,150)"/>
